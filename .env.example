# ============ 火山引擎方舟（主路线）============
# 控制台 https://console.volcengine.com/ark → API Key管理 创建
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ⚠ 模型ID带日期后缀，且须先在方舟控制台「开通管理」页开通对应模型
# 下方为2026-09在售版本示例，请以控制台显示为准
ARK_LLM_MODEL=doubao-seed-2-0-lite-260428
ARK_T2I_MODEL=doubao-seedream-5-0-260128
# 扮相转换：SeedEdit专用模型已下线，编辑由Seedream参考图能力实现，填同一个文生图模型
ARK_I2I_MODEL=doubao-seedream-5-0-260128
# 视频生成（Seedance，需在方舟「开通管理」页开通；mini为最便宜档）
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615

# ============ 智谱开放平台（免费备用）============
# https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_LLM_MODEL=glm-4-flash
ZHIPU_T2I_MODEL=cogview-3-flash

# ============ 硅基流动 SiliconFlow（视频路线，用赠送额度）============
# 注册 https://cloud.siliconflow.cn → API密钥；Wan2.2按条计费（赠送额度可生成数十条视频）
SF_API_KEY=
SF_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
SF_VIDEO_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B

# ============ 服务选择 ============
# 图像: ark | zhipu | pollinations | mock
# 文本: ark | zhipu | mock
# 视频: ark（火山Seedance，付费高质量）| siliconflow（Wan免费档）| mock
IMAGE_PROVIDER=ark
LLM_PROVIDER=ark
VIDEO_PROVIDER=ark

# ============ 其他 ============
# Streamlit 演示密码（公网部署务必设置；留空不启用）
DEMO_PASSWORD=
# 会话密钥（本地可随意；公网部署务必随机长字符串）
SECRET_KEY=change-me
